generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String               @map("password_hash")
  phone               String?
  avatarUrl           String?              @map("avatar_url")
  role                Role                 @default(CUSTOMER)
  isActive            Boolean              @default(true) @map("is_active")
  emailVerified       Boolean              @default(false) @map("email_verified")
  birthDate           DateTime?            @map("birth_date") @db.Date
  lastLogin           DateTime?            @map("last_login")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  customer            Customer?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Banner {
  id             String   @id @default(uuid())
  title          String
  subtitle       String?
  imageUrl       String   @map("image_url")
  mobileImageUrl String?  @map("mobile_image_url")
  buttonText     String?  @map("button_text")
  buttonLink     String?  @map("button_link")
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model Category {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  description    String?
  imageUrl       String?   @map("image_url")
  bannerImageUrl String?   @map("banner_image_url")
  isActive       Boolean   @default(true) @map("is_active")
  displayOrder   Int       @default(0) @map("display_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  products       Product[]

  @@map("categories")
}

model Product {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  shortDescription String           @map("short_description")
  description      String
  categoryId       String           @map("category_id")
  category         Category         @relation(fields: [categoryId], references: [id])
  collectionId     String?          @map("collection_id")
  collection       Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  basePrice        Decimal          @map("base_price") @db.Decimal(10, 2)
  coverImage       String           @map("cover_image")
  isFeatured       Boolean          @default(false) @map("is_featured")
  isNew            Boolean          @default(false) @map("is_new")
  isOnSale         Boolean          @default(false) @map("is_on_sale")
  compareAtPrice   Decimal?         @map("compare_at_price") @db.Decimal(10, 2)
  isActive         Boolean          @default(true) @map("is_active")
  seoTitle         String?          @map("seo_title")
  seoDescription   String?          @map("seo_description")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  variants         ProductVariant[]
  images           ProductImage[]

  @@map("products")
}

model Collection {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  description       String?
  bannerImageUrl    String    @map("banner_image_url")
  thumbnailImageUrl String    @map("thumbnail_image_url")
  launchDate        DateTime  @map("launch_date")
  endDate           DateTime? @map("end_date")
  isActive          Boolean   @default(true) @map("is_active")
  isFeatured        Boolean   @default(false) @map("is_featured")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  products          Product[]

  @@map("collections")
}

model ProductVariant {
  id            String     @id @default(uuid())
  productId     String     @map("product_id")
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String     @unique
  color         String
  size          String
  priceOverride Decimal?   @map("price_override") @db.Decimal(10, 2)
  stock         Int        @default(0)
  isActive      Boolean    @default(true) @map("is_active")
  weightKg      Decimal?   @map("weight_kg") @db.Decimal(6, 3)
  lengthCm      Decimal?   @map("length_cm") @db.Decimal(6, 2)
  widthCm       Decimal?   @map("width_cm") @db.Decimal(6, 2)
  heightCm      Decimal?   @map("height_cm") @db.Decimal(6, 2)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  cartItems     CartItem[]

  @@unique([productId, color, size])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String   @map("image_url")
  altText      String?  @map("alt_text")
  color        String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model Cart {
  id        String     @id @default(uuid())
  token     String     @unique
  userId    String?    @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id               String         @id @default(uuid())
  cartId           String         @map("cart_id")
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String         @map("product_variant_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

enum LogisticStatus {
  PENDING
  LABEL_PENDING
  LABEL_CREATED
  POSTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum MelhorEnvioEnvironment {
  SANDBOX
  PRODUCTION
}

enum OrderStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model ShippingMethod {
  id           String   @id @default(uuid())
  name         String
  provider     String
  serviceCode  String   @map("service_code")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]

  @@unique([provider, serviceCode])
  @@map("shipping_methods")
}

model ShippingCarrier {
  id            String            @id @default(uuid())
  provider      String
  externalId    String            @map("external_id")
  name          String
  logoUrl       String?           @map("logo_url")
  isActive      Boolean           @default(true) @map("is_active")
  displayOrder  Int               @default(0) @map("display_order")
  customMessage String?           @map("custom_message")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  services      ShippingService[]

  @@unique([provider, externalId])
  @@map("shipping_carriers")
}

model ShippingService {
  id            String          @id @default(uuid())
  carrierId     String          @map("carrier_id")
  carrier       ShippingCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  externalId    String          @map("external_id")
  name          String
  description   String?
  isActive      Boolean         @default(true) @map("is_active")
  displayOrder  Int             @default(0) @map("display_order")
  customMessage String?         @map("custom_message")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  orders        Order[]

  @@unique([carrierId, externalId])
  @@map("shipping_services")
}

model Order {
  id                   String          @id @default(uuid())
  orderNumber          String          @unique @map("order_number")
  customerId           String          @map("customer_id")
  customer             Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName         String          @map("customer_name")
  customerEmail        String          @map("customer_email")
  customerPhone        String          @map("customer_phone")
  customerCpf          String?         @map("customer_cpf")
  status               OrderStatus     @default(WAITING_PAYMENT)
  shippingMethod       String          @map("shipping_method")
  shippingMethodId     String?         @map("shipping_method_id")
  shippingMethodRef    ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingServiceId    String?         @map("shipping_service_id")
  shippingServiceRef   ShippingService? @relation(fields: [shippingServiceId], references: [id], onDelete: SetNull)
  shippingProvider     String?         @map("shipping_provider")
  shippingService      String?         @map("shipping_service")
  shippingPrice        Decimal         @map("shipping_price") @db.Decimal(10, 2)
  shippingDeadlineDays Int?            @map("shipping_deadline_days")
  trackingCode         String?         @map("tracking_code")
  shippingLabelId      String?         @map("shipping_label_id")
  shippingLabelUrl     String?         @map("shipping_label_url")
  logisticStatus       LogisticStatus? @map("logistic_status")
  subtotal             Decimal         @db.Decimal(10, 2)
  discount             Decimal         @default(0) @db.Decimal(10, 2)
  total                Decimal         @db.Decimal(10, 2)
  paymentExpiresAt     DateTime        @map("payment_expires_at")
  stockRestored        Boolean         @default(false) @map("stock_restored")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  items                OrderItem[]
  address              Address?
  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  promotionId          String?           @map("promotion_id")
  promotion            Promotion?        @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionCode        String?           @map("promotion_code")
  promotionUsages      PromotionUsage[]
  shippingEvents       ShippingEvent[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String  @map("order_id")
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String  @map("product_id")
  productVariantId String  @map("product_variant_id")
  productName      String  @map("product_name")
  sku              String
  color            String?
  size             String?
  imageUrl         String? @map("image_url")
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal         Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  orderId        String       @map("order_id")
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  adminId        String       @map("admin_id")
  adminEmail     String       @map("admin_email")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Address {
  id         String  @id @default(uuid())
  orderId    String  @unique @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipient  String
  zipCode    String  @map("zip_code")
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  country    String  @default("BR")
  reference  String?

  @@map("addresses")
}

model Customer {
  id            String            @id @default(uuid())
  name          String
  email         String
  phone         String
  cpf           String?
  cpfNormalized String?           @unique @map("cpf_normalized")
  cpfPending    Boolean           @default(true) @map("cpf_pending")
  birthDate     DateTime?         @map("birth_date") @db.Date
  isGuest       Boolean           @default(true) @map("is_guest")
  userId        String?           @unique @map("user_id")
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  orders        Order[]
  addresses     CustomerAddress[]
  promotionUsages PromotionUsage[]

  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipient  String
  zipCode    String   @map("zip_code")
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  country    String   @default("BR")
  reference  String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("customer_addresses")
}

enum PaymentProvider {
  MERCADO_PAGO
}

enum PaymentMethodType {
  PIX
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

model Payment {
  id                String             @id @default(uuid())
  orderId           String             @map("order_id")
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider    @default(MERCADO_PAGO)
  providerPaymentId String?            @unique @map("provider_payment_id")
  paymentMethod     PaymentMethodType  @map("payment_method")
  amount            Decimal            @db.Decimal(10, 2)
  status            PaymentStatus      @default(PENDING)
  installments      Int?
  pixQrCode         String?            @map("pix_qr_code")
  pixQrCodeBase64   String?            @map("pix_qr_code_base64")
  pixCopyPaste      String?            @map("pix_copy_paste")
  pixExpiresAt      DateTime?          @map("pix_expires_at")
  rawResponse       Json?              @map("raw_response")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([orderId, createdAt])
  @@index([status])
  @@map("payments")
}

model PaymentWebhookEvent {
  id               String   @id @default(uuid())
  providerEventKey String   @unique @map("provider_event_key")
  payload          Json
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("payment_webhook_events")
}

enum PromotionType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum PromotionApplicationType {
  COUPON
  AUTOMATIC
}

enum PromotionTargetType {
  PRODUCT
  CATEGORY
  COLLECTION
  STORE
}

model Promotion {
  id                    String                   @id @default(uuid())
  name                  String
  description           String?
  code                  String?                  @unique
  applicationType       PromotionApplicationType @map("application_type")
  type                  PromotionType
  value                 Decimal                  @db.Decimal(10, 2)
  minimumOrderValue     Decimal?                 @map("minimum_order_value") @db.Decimal(10, 2)
  maximumDiscount       Decimal?                 @map("maximum_discount") @db.Decimal(10, 2)
  startDate             DateTime                 @map("start_date")
  endDate               DateTime?                @map("end_date")
  usageLimit            Int?                     @map("usage_limit")
  usageCount            Int                      @default(0) @map("usage_count")
  usageLimitPerCustomer Int?                     @map("usage_limit_per_customer")
  firstPurchaseOnly     Boolean                  @default(false) @map("first_purchase_only")
  isActive              Boolean                  @default(true) @map("is_active")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  targets               PromotionTarget[]
  usages                PromotionUsage[]
  orders                Order[]

  @@map("promotions")
}

model PromotionTarget {
  id          String              @id @default(uuid())
  promotionId String              @map("promotion_id")
  promotion   Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  targetType  PromotionTargetType @map("target_type")
  targetId    String?             @map("target_id")

  @@index([promotionId])
  @@map("promotion_targets")
}

model PromotionUsage {
  id          String    @id @default(uuid())
  promotionId String    @map("promotion_id")
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customerId  String    @map("customer_id")
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId     String    @map("order_id")
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usedAt      DateTime  @default(now()) @map("used_at")

  @@index([promotionId])
  @@index([customerId])
  @@index([orderId])
  @@map("promotion_usages")
}

model StoreSetting {
  id                String   @id @default("default")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  crmVipThreshold   Decimal  @default(3000) @map("crm_vip_threshold") @db.Decimal(10, 2)
  crmInactiveDays   Int      @default(90) @map("crm_inactive_days")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model DashboardAccessLog {
  id         String   @id @default(uuid())
  adminEmail String   @map("admin_email")
  accessedAt DateTime @default(now()) @map("accessed_at")

  @@index([accessedAt])
  @@map("dashboard_access_logs")
}

model CrmAccessLog {
  id         String   @id @default(uuid())
  adminEmail String   @map("admin_email")
  action     String
  customerId String?  @map("customer_id")
  accessedAt DateTime @default(now()) @map("accessed_at")

  @@index([accessedAt])
  @@map("crm_access_logs")
}

model MelhorEnvioConfig {
  id                    String                 @id @default("default")
  clientId              String?                @map("client_id")
  clientSecretEncrypted String?                @map("client_secret_encrypted")
  accessTokenEncrypted  String?                @map("access_token_encrypted")
  refreshTokenEncrypted String?                @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime?              @map("token_expires_at")
  environment           MelhorEnvioEnvironment @default(SANDBOX)
  isConnected           Boolean                @default(false) @map("is_connected")
  lastSyncedAt          DateTime?              @map("last_synced_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@map("melhor_envio_configs")
}

model ShippingSender {
  id         String   @id @default(uuid())
  name       String
  company    String?
  document   String
  phone      String
  zipCode    String   @map("zip_code")
  address    String
  number     String
  complement String?
  district   String
  city       String
  state      String
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("shipping_senders")
}

model ShippingPackage {
  id              String   @id @default(uuid())
  name            String
  lengthCm        Decimal  @map("length_cm") @db.Decimal(6, 2)
  widthCm         Decimal  @map("width_cm") @db.Decimal(6, 2)
  heightCm        Decimal  @map("height_cm") @db.Decimal(6, 2)
  maxWeightKg     Decimal  @map("max_weight_kg") @db.Decimal(6, 3)
  packageWeightKg Decimal  @map("package_weight_kg") @db.Decimal(6, 3)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shipping_packages")
}

model ShippingEvent {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  status      String
  description String
  location    String?
  eventDate   DateTime @map("event_date")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderId, eventDate])
  @@map("shipping_events")
}

model ShippingWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  externalId  String?   @map("external_id")
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@map("shipping_webhook_events")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  isActive       Boolean   @default(true) @map("is_active")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isActive, subscribedAt])
  @@map("newsletter_subscribers")
}

model SearchQueryLog {
  id          String   @id @default(uuid())
  term        String
  termNormalized String @map("term_normalized")
  resultsCount Int     @map("results_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([termNormalized, createdAt])
  @@index([createdAt])
  @@map("search_query_logs")
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum EmailLogStatus {
  SENT
  DELIVERED
  FAILED
  REJECTED
  CANCELLED
}

enum EmailRecipientType {
  ALL
  ACTIVE_ONLY
  SELECTED
}

model EmailSettings {
  id               String   @id @default(uuid())
  provider         String   @default("resend")
  apiKey           String?  @map("api_key")
  domain           String?
  fromName         String?  @map("from_name")
  fromEmail        String?  @map("from_email")
  replyTo          String?  @map("reply_to")
  sandbox          Boolean  @default(true)
  resendSegmentId  String?  @map("resend_segment_id")
  resendSyncEnabled Boolean @default(false) @map("resend_sync_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

model EmailTemplate {
  id        String          @id @default(uuid())
  name      String
  subject   String
  html      String          @db.Text
  text      String?         @db.Text
  variables String[]        @default([])
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  campaigns EmailCampaign[]

  @@map("email_templates")
}

model EmailCampaign {
  id              String              @id @default(uuid())
  name            String
  subject         String
  fromName        String?             @map("from_name")
  fromEmail       String?             @map("from_email")
  replyTo         String?             @map("reply_to")
  html            String              @db.Text
  text            String?             @db.Text
  status          EmailCampaignStatus @default(DRAFT)
  recipientType   EmailRecipientType  @default(ACTIVE_ONLY) @map("recipient_type")
  recipientEmails String[]            @default([]) @map("recipient_emails")
  recipientCount  Int                 @default(0) @map("recipient_count")
  templateId      String?             @map("template_id")
  template        EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledAt     DateTime?           @map("scheduled_at")
  sentAt          DateTime?           @map("sent_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  logs            EmailLog[]

  @@index([status, scheduledAt])
  @@map("email_campaigns")
}

model EmailLog {
  id         String             @id @default(uuid())
  campaignId String?            @map("campaign_id")
  campaign   EmailCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipient  String
  status     EmailLogStatus
  providerId String?            @map("provider_id")
  message    String?
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([campaignId, createdAt])
  @@index([status, createdAt])
  @@map("email_logs")
}
